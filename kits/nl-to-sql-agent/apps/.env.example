# Lamatic API credentials
LAMATIC_API_URL=https://api.lamatic.ai
LAMATIC_PROJECT_ID=your_lamatic_project_id
LAMATIC_API_KEY=your_lamatic_api_key

# Queryline Flow ID (set after deploying the flow in Lamatic Studio)
NL_TO_SQL_FLOW_ID=your_deployed_flow_id

# Session secret for iron-session
SESSION_PASSWORD=a_complex_password_at_least_32_chars_long!!

# Demo authentication configuration
# Set DEMO_AUTH_ENABLED to "true" to enable demo authentication.
# Both DEMO_USERNAME and DEMO_PASSWORD must be configured when enabled.
# Demo authentication is disabled by default for security (fail-closed).
DEMO_AUTH_ENABLED=true
DEMO_USERNAME=your-demo-username
DEMO_PASSWORD=your-demo-password

# Optional: return a canned response for local front-end testing without calling Lamatic
MOCK_LAMATIC=true

# Optional: Azure SQL connection details for the flow's Microsoft SQL Server node
# These are typically configured in Lamatic Studio credentials.
MSSQL_SERVER=your_azure_sql_server.database.windows.net
MSSQL_PORT=1433
MSSQL_DATABASE=your_azure_sql_database
MSSQL_USER=your_azure_sql_user